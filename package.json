{
  "name": "missione-italia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "validate:content": "node scripts/validate-contracts.mjs && node scripts/validate-assets.mjs && node scripts/validate-narration-pack.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test": "vitest run",
    "build": "vite build && node scripts/audit-precache.mjs",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run lint && npm run validate:content && npm test && npm run build",
    "icons": "python scripts/generate-icons.py"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.4",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  }
}
