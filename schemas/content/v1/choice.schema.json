{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missione-italia.example/schemas/content/v1/choice.schema.json",
  "title": "Mission choice",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "correct"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "label": {"type": "string", "minLength": 1, "maxLength": 120},
    "correct": {"type": "boolean"},
    "hint": {"type": "string", "minLength": 1, "maxLength": 180}
  }
}
