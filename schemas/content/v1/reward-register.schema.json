{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missione-italia.example/schemas/content/v1/reward-register.schema.json",
  "title": "Reward register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "powers", "stamps"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "powers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "chapterId"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "chapterId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64}
        }
      }
    },
    "stamps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
          "label": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      }
    }
  }
}
