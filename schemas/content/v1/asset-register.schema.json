{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missione-italia.example/schemas/content/v1/asset-register.schema.json",
  "title": "Asset register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "assets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mediaType", "license", "offlineCritical"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$", "maxLength": 240},
          "mediaType": {"type": "string", "enum": ["image/avif", "image/png", "image/svg+xml", "image/webp", "audio/mpeg", "audio/ogg"]},
          "license": {"type": "string", "minLength": 1, "maxLength": 160},
          "offlineCritical": {"type": "boolean"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
