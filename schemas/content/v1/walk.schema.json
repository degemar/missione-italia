{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missione-italia.example/schemas/content/v1/walk.schema.json",
  "title": "Curated walk GeoJSON",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "properties", "features"],
  "properties": {
    "type": {"const": "FeatureCollection"},
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "chapterId", "mode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "chapterId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
        "mode": {"type": "string", "enum": ["tired-legs", "full-explorer"]}
      }
    },
    "features": {
      "type": "array",
      "minItems": 2,
      "items": {"oneOf": [{"$ref": "#/$defs/checkpoint"}, {"$ref": "#/$defs/route"}]}
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -90, "maximum": 90}
      ],
      "items": false
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Point"},
            "coordinates": {"$ref": "#/$defs/position"}
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "order", "label", "missionIds"],
          "properties": {
            "kind": {"const": "checkpoint"},
            "order": {"type": "integer", "minimum": 1},
            "label": {"type": "string", "minLength": 1, "maxLength": 160},
            "missionIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+$", "maxLength": 64}
            }
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "LineString"},
            "coordinates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/position"}}
          }
        },
        "properties": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "checkpointIds"],
          "properties": {
            "kind": {"const": "route"},
            "checkpointIds": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96}
            }
          }
        }
      }
    }
  }
}
