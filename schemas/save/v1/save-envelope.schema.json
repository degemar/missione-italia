{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missione-italia.example/schemas/save/v1/save-envelope.schema.json",
  "title": "Missione Italia local save envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "tripKey", "contentVersion", "journeyState", "localRevision",
    "family", "route", "missionProgress", "excursionSelection", "settings", "backup"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "tripKey": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
    "contentVersion": {"type": "string", "pattern": "^trip-[0-9]{4}\\.[0-9]{2}-v[1-9][0-9]*$", "maxLength": 64},
    "journeyState": {"type": "string", "enum": ["fresh", "in-progress", "completed", "reset"]},
    "localRevision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["members", "roleRotationIndex"],
      "properties": {
        "members": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/member"}
        },
        "roleRotationIndex": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenId", "chapterId", "missionId", "stage", "selectedWalkId"],
      "properties": {
        "screenId": {
          "type": "string",
          "enum": ["WELCOME", "SETUP", "ATLAS", "CHAPTER", "MISSION", "STORY", "LOOK-UP", "CHALLENGE", "CELEBRATION", "PASSPORT", "EPILOGUE", "PARENT"]
        },
        "chapterId": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
        "missionId": {"type": ["string", "null"], "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+$", "maxLength": 64},
        "stage": {"type": ["string", "null"], "enum": [null, "story", "look-up", "challenge", "celebration"]},
        "selectedWalkId": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96}
      }
    },
    "missionProgress": {
      "type": "object",
      "maxProperties": 512,
      "propertyNames": {"pattern": "^[A-Z]+(?:-[A-Z0-9]+)+$", "maxLength": 64},
      "additionalProperties": {"$ref": "#/$defs/missionProgress"}
    },
    "excursionSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedPairId"],
      "properties": {
        "selectedPairId": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96}
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "italianPhrases", "sound", "reducedMotion", "highContrast"],
      "properties": {
        "language": {"const": "en"},
        "italianPhrases": {"type": "boolean"},
        "sound": {"type": "boolean"},
        "reducedMotion": {"type": "boolean"},
        "highContrast": {"type": "boolean"}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "dirty", "lastSuccessfulRevision", "lastSuccessfulSyncAt"],
      "properties": {
        "enabled": {"type": "boolean"},
        "dirty": {"type": "boolean"},
        "lastSuccessfulRevision": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
        "lastSuccessfulSyncAt": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nickname", "ageBand", "avatarId"],
      "properties": {
        "id": {"type": "string", "pattern": "^child-[1-3]$"},
        "nickname": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[^\\r\\n<>]{1,24}$"},
        "ageBand": {"type": "string", "enum": ["4-6", "7-8", "9-11"]},
        "avatarId": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64}
      }
    },
    "missionProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "resolvedVariantId"],
      "properties": {
        "state": {"type": "string", "enum": ["in-progress", "completed", "manual", "skipped"]},
        "resolvedVariantId": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96}
      }
    }
  }
}
